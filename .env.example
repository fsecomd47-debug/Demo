# === PANTHI DENTAL CLINIC - Environment Variables ===

# EmailJS (required for appointment email notifications)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# OpenRouter (required for AI chatbot)
OPENROUTER_API_KEY=

# Google Calendar (optional - for automatic calendar event creation)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Cartesia TTS (optional - for AI voice assistant)
CARTESIA_API_KEY=
